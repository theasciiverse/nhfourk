[0.000, "o", "35;40m│\u001b[24C\u001b[0;37;40m                             \u001b[24C\u001b[0;35;40m│\u001b[10;1H\u001b[0;1;30;90;40m  \u001b[0;37;40m|....\u001b[0;1;37;97;4;41m@\u001b[0;37;40m..\u001b[0;35;40m│\u001b[5C\u001b[0;37;40mAfter the Creation, the cruel god Moloch rebelled\u001b[23C\u001b[0;35;40m│\u001b[11;1H\u001b[0;1;30;90;40m  \u001b[0;37;40m|.....\u001b[0;37;44mf\u001b[0;37;40m.\u001b[0;35;40m│\u001b[5C\u001b[0;37;40magainst the authority of Marduk the Creator.    \u001b[24C\u001b[0;35;40m│\u001b[12;1H\u001b[0;1;30;90;40m  \u001b[0;37;40m--.-----\u001b[0;35;40m│\u001b[5C\u001b[0;37;40mMoloch stole from Marduk the most powerful of all\u001b[23C\u001b[0;35;40m│\u001b[13;1H\u001b[0;1;30;90;40m          \u001b[0;35;40m│\u001b[5C\u001b[0;37;40mthe artifacts of the gods, the Amulet of Yendor,\u001b[24C\u001b[0;35;40m│\u001b[14;1H\u001b[0;1;30;90;40m          \u001b[0;35;40m│\u001b[0;37;40m     and he hid it in the dark cavities of Gehennom, the                     \u001b[0;35;40m│\u001b[15;1H\u001b[0;1;30;90;40m          \u001b[2C\u001b[0;37;40m    Under World, where he now lurks, and bides his time.    \u001b[16;1H\u001b[0;1;30;90;40m          \u001b[2C\u001b[0;37;40m                                                                           \u001b[17"]
[0.000, "o", ";1H\u001b[0;1;30;90;40m          \u001b[0;35;40m│\u001b[0;37;40m Your god Crom seeks to possess the Amulet, and with it to gain deserved     \u001b[0;35;40m│\u001b[18;1H\u001b[0;1;30;90;40m          \u001b[0;35;40m│\u001b[C\u001b[0;37;40mascendance over the other gods.\u001b[45C\u001b[0;35;40m│\u001b[19;1H\u001b[0;1;30;90;40m          \u001b[0;35;40m│\u001b[77C│\u001b[20;1H\u001b[0;1;30;90;40m          \u001b[0;35;40m│\u001b[C\u001b[0;37;40mYou, a newly trained Barbarian, have been heralded from birth as the\u001b[8C\u001b[0;35;40m│\u001b[21;1H\u001b[0;1;30;90;40m          \u001b[0;35;40m│\u001b[C\u001b[0;37;40minstrument of Crom.  You are destined to recover the Amulet for your deity, \u001b[0;35;40m│\u001b[22;1H\u001b[0;1;30;90;40m          \u001b[0;35;40m│\u001b[C\u001b[0;37;40mor die in the attempt.  Your hour of destiny has come.  For the sake of us  \u001b[0;35;40m│\u001b[23;1H\u001b[0;1;30;90;40m          \u001b[0;35;40m│\u001b[C\u001b[0;37;40mall:  Go bravely with Crom!\u001b[49C\u001b[0;35;40m│\u001b[24;1H\u001b[0;1;30;90;40m          \u001b[0;35;40m└───────────────────────────────────────────────"]
